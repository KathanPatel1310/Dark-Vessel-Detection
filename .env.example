# ==============================================================================
# MARITIME INTELLIGENCE & DARK VESSEL DETECTION SYSTEM - ENVIRONMENT CONFIG
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# NOTE: The system is designed to run in offline/mock mode with synthetic fixtures
# if external API tokens are not provided.
# ==============================================================================

# Global Fishing Watch (GFW) API
# Get a free research token at: https://globalfishingwatch.org/our-apis/tokens
GFW_API_KEY=your_gfw_api_key_here

# Copernicus Data Space Ecosystem (CDSE)
# Register for free at: https://dataspace.copernicus.eu/
CDSE_USERNAME=your_cdse_username
CDSE_PASSWORD=your_cdse_password

# Hugging Face Access Token (for open-weight models e.g., Qwen / Llama)
# Free registration at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# System Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=./data
FIXTURES_DIR=./data/fixtures
STORAGE_BUDGET_GB=10.0
